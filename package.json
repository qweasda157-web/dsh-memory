{
  "name": "dsh-memory",
  "version": "0.2.0",
  "description": "跨天的记忆：把经历过的事按天写进磁盘，启动时把最近几天带回上下文，也能按日期回查。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-remember": "./bin/remember.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/",
    "bin/",
    "examples/",
    "test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/verify.mjs",
    "demo": "node examples/demo.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "agent",
    "diary"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
